# KisanAgro Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Browser origin(s) allowed to call the API. Comma-separate multiple origins.
CLIENT_ORIGIN=http://localhost:5173

# Security: mandatory secret key for JWT session tokens (generate a strong random string)
JWT_SECRET=kisan_secret_jwt_key_2026_change_in_production

# Every new order is emailed here. This is the store owner's inbox.
ORDER_NOTIFICATION_EMAIL=business615@gmail.com

# Store admin account, created on first boot. Change the password before launch.
ADMIN_EMAIL=admin@kisanagro.com
ADMIN_PASSWORD=Admin@Kisan2026

# ---- Outgoing mail (SMTP) ----
# Orders work without this: the email is recorded in the admin panel email log
# instead of being sent. Fill these in to actually deliver order emails.
#
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-sending-address@gmail.com
#   SMTP_PASS=the-16-character-app-password
#
# Other providers (Brevo, Zoho, Mailgun, SES SMTP) work the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to SMTP_USER, or the notification address if no user is set.
SMTP_FROM=

# Optional: enables live Gemini multimodal diagnosis instead of the offline knowledge base
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
